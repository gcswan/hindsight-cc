{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ensure-hindsight.sh",
            "timeout": 30000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/hs-python.sh ${CLAUDE_PLUGIN_ROOT}/scripts/retain-prompt.py"
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/hs-python.sh ${CLAUDE_PLUGIN_ROOT}/scripts/inject-memories.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/hs-python.sh ${CLAUDE_PLUGIN_ROOT}/scripts/retain-transcript.py"
          }
        ]
      }
    ]
  }
}
